# CAD3PLogBrowser - Ollama Configuration

# Instructions:
# 1. Install Ollama on a server in your network (see SETUP_GUIDE.md)
# 2. Update the values below with your server details
# 3. Save this file and reference it in your application
# 4. Distribute the same configuration to all users

# Ollama Server Configuration
[Ollama]
# URL of your Ollama server
# Examples:
#   - Local testing: http://localhost:11434
#   - Corporate server: http://ollama-server.corp.ptc.com:11434
#   - IP address: http://192.168.1.100:11434
ServerUrl=http://localhost:11434

# Model to use for log analysis
# Recommended options:
#   - llama3 (best balance of quality and speed)
#   - codellama (best for technical/code logs)
#   - mistral (fast and efficient)
#   - phi3 (lightweight, fastest)
Model=llama3

# Request timeout in seconds (increase for CPU-only servers)
TimeoutSeconds=120

# Default temperature (0.0 = deterministic, 1.0 = creative)
# For log analysis, 0.7 is a good balance
DefaultTemperature=0.7

# Default max tokens for responses
DefaultMaxTokens=4096

# Enable/Disable AI features
EnableAI=true

# Fallback behavior if Ollama is unavailable
# Options: ShowError, DisableFeature, UseCache
FallbackBehavior=ShowError

# PTC Internal GitHub Enterprise (if using GitHub Copilot as fallback)
[GitHubCopilot]
# Only needed if you want GitHub Copilot as a backup option
# Not recommended due to cost and data privacy concerns
Enabled=false
ApiEndpoint=https://api.github.ptc.com/copilot/chat/completions
ApiToken=

# Application Settings
[Application]
# Show AI analysis panel by default
ShowAIPanelOnStartup=true

# Enable streaming responses (shows text as it's generated)
EnableStreamingResponses=true

# Cache AI responses to reduce server load
EnableResponseCache=true
CacheDurationMinutes=60

# Maximum log lines to send to AI in a single request
MaxLogLinesPerRequest=1000

# System prompt for log analysis (customize for your needs)
SystemPrompt=You are an expert at analyzing CAD application logs. Focus on identifying errors, performance issues, and suggesting actionable solutions.
